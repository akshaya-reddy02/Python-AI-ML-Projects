# Copy this file to .env and set your own values.
# Never commit the real .env file.

# Orthanc / DICOM integration
ORTHANC_URL=http://127.0.0.1:8042
ORTHANC_USERNAME=demo
ORTHANC_PASSWORD=change-me

# Feature gates.
# Keep these false on memory-constrained hosts (for example, Render Free 512 MB).
# Set them to true locally when you have enough memory and a running Orthanc server.
ENABLE_SEGMENTATION=false
ENABLE_ORTHANC_MONITOR=false
